# GEMINI_API_KEY / AI_API_KEY: Required for AI pitch generation (uses Gemini).
# AI Studio automatically injects GEMINI_API_KEY at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_API_KEY="MY_AI_API_KEY"

# SERPAPI_KEY: SerpApi key for Google Local / Maps search.
# When missing, the application clearly notifies the user and provides a safe test mode toggle with mock data if requested.
SERPAPI_KEY="MY_SERPAPI_KEY"

# SUPABASE: Supabase PostgreSQL credentials.
# When configured, leads, searches, and notes persist in your Supabase database.
# When not set, the app falls back to a resilient local storage/in-memory session database with zero crashes and full CRUD.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

